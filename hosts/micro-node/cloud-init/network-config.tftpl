version: 2
ethernets:
  ${parent_interface}:
    dhcp4: false
    dhcp6: false
    accept-ra: false
bridges:
  br0:
    interfaces:
      - ${parent_interface}
    dhcp4: false
    dhcp6: false
    accept-ra: false
    parameters:
      stp: false
      forward-delay: 0
vlans:
  br0.${management_vlan_id}:
    id: ${management_vlan_id}
    link: br0
    dhcp4: false
    dhcp6: false
    accept-ra: false
    addresses:
      - ${management_address_cidr}
    routes:
      - to: default
        via: ${gateway_ipv4}
    nameservers:
      addresses:
%{ for server in dns_servers ~}
        - ${server}
%{ endfor ~}
