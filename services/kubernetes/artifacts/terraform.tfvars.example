# Copy to terraform.tfvars, fill required inputs privately, and never commit it.
# Provider credentials: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and VAULT_TOKEN.
# Clear unrelated AWS_SESSION_TOKEN, profile and endpoint overrides before use.

# -----------------------------------------------------------------------------
# Provider — Required
# -----------------------------------------------------------------------------
# s3_endpoint     =
# openbao_address =

# Provider — Optional
# s3_region = "us-east-1"

# -----------------------------------------------------------------------------
# Cluster artifacts — Required
# -----------------------------------------------------------------------------
# configuration_bucket =
# backup_bucket        =
# api_server           =
# approle_mount        =
# publisher_secret_path =

# Cluster artifacts — Optional
# cluster_uid     = null
# enrollment_name = "control-plane"
# A null UID permits only rke2/*/kubeconfig.yaml within the dedicated config bucket
# for first creation; use the actual namespace UID for exact-key scope afterwards.
