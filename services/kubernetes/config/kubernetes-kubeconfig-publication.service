[Unit]
Description=Publish the initializing Kubernetes server kubeconfig without overwriting another artifact
After=network-online.target rke2-server.service
Wants=network-online.target
ConditionPathExists=/etc/rancher/rke2/publication-credentials.json

[Service]
Type=oneshot
User=root
UMask=0077
Environment=HOME=/run/kubernetes-publication
RuntimeDirectory=kubernetes-publication
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 -B /usr/local/libexec/homelab/publish-kubeconfig.py --execute
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/kubernetes-publication
