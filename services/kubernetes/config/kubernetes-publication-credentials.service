[Unit]
Description=Fetch application-scoped Kubernetes publication credentials from OpenBao
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/rancher/rke2/publication-approle.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/kubeconfig-credentials refresh
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/rancher/rke2 /run/kubernetes-publication-credentials
