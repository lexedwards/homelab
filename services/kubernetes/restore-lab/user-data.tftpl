#cloud-config
hostname: ${jsonencode(name)}
preserve_hostname: true
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
users:
  - name: ${jsonencode(cloud_user)}
    lock_passwd: true
    groups: [wheel]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys: ${jsonencode(ssh_keys)}
packages: [ca-certificates, curl, python3, iproute, qemu-guest-agent]
write_files:
  - path: /etc/hostname
    owner: root:root
    permissions: "0644"
    content: ${jsonencode(name)}
  - path: /usr/libexec/qemu-ga/fsfreeze-hook.d/homelab-restore
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${restore_guest}
  - path: /etc/qemu/restore-lab.conf
    owner: root:root
    permissions: "0644"
    content: |
      [general]
      method=virtio-serial
      path=/dev/virtio-ports/org.qemu.guest_agent.0
      daemonize=false
      retry-path=true
      logfile=/dev/null
      allow-rpcs=guest-sync,guest-sync-delimited,guest-ping,guest-info,guest-network-get-interfaces,guest-get-osinfo,guest-get-host-name,guest-fstrim,guest-shutdown,guest-exec,guest-exec-status
  - path: /etc/systemd/system/qemu-guest-agent.service.d/10-restore-lab.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      Type=simple
      ExecStart=
      ExecStart=/usr/bin/qemu-ga --config=/etc/qemu/restore-lab.conf
      StandardOutput=null
      StandardError=null
  - path: /usr/local/sbin/install-kubernetes-server
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${installer}
  - path: /usr/local/sbin/kubernetes-node-preflight
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${node_preflight}
  - path: /usr/local/sbin/prepare-restore-lab
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${prepare_script}
  - path: /etc/rancher/rke2/config.yaml
    owner: root:root
    permissions: "0600"
    content: |
      selinux: true
      cni: none
      disable-scheduler: true
      disable-cloud-controller: true
      disable-kube-proxy: true
      etcd-disable-snapshots: true
      write-kubeconfig-mode: "0600"
  - path: /etc/systemd/system/rke2-server.service.d/10-restore-fence.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      ConditionPathExists=/run/homelab-restore-fenced
      [Service]
      StandardOutput=null
      StandardError=null
runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, restart, qemu-guest-agent]
  - [systemctl, enable, --now, qemu-guest-agent]
  - [bash, /usr/local/sbin/prepare-restore-lab, "${allow_unconfined_guest_exec}"]
power_state:
  mode: reboot
  delay: now
  timeout: 60
  condition: [test, -f, /var/lib/homelab-restore-prepared]
