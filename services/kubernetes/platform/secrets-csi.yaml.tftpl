apiVersion: v1
kind: Namespace
metadata:
  name: secrets-system
  labels:
    pod-security.kubernetes.io/enforce: privileged
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: secrets-store-csi
  namespace: kube-system
  annotations:
    homelab.io/chart-source: https://kubernetes-sigs.github.io/secrets-store-csi-driver/charts/secrets-store-csi-driver-1.6.2.tgz
    homelab.io/chart-sha256: 2658657164b156c7759772a84ba83013ae2495a0b2d2e92ea6b2ad0738f623c4
spec:
  chartContent: ${driver_chart}
  targetNamespace: secrets-system
  timeout: 10m0s
  failurePolicy: abort
  backOffLimit: 0
  valuesContent: |
    linux:
      enabled: true
      image:
        repository: registry.k8s.io/csi-secrets-store/driver
        tag: v1.6.2
        digest: sha256:939ef17f3840e0902fe5d6d16574bdc2e70636994ca0107f52bb3b9bc67df081
      crds:
        enabled: false
      registrarImage:
        repository: registry.k8s.io/sig-storage/csi-node-driver-registrar
        tag: v2.16.0
        digest: sha256:ab482308a4921e28a6df09a16ab99a457e9af9641ff44fb1be1a690d07ce8b70
      livenessProbeImage:
        repository: registry.k8s.io/sig-storage/livenessprobe
        tag: v2.18.0
        digest: sha256:c4cc074199c045dd73ab85f28897e2a32f4d6f38ffdba4f3b13b8007ccbd3570
      kubeletRootDir: /var/lib/kubelet
      providersDir: /var/run/secrets-store-csi-providers
      additionalProvidersDirs:
        - /etc/kubernetes/secrets-store-csi-providers
      nodeSelector:
        homelab.io/role: worker
        homelab.node-restriction.kubernetes.io/secrets-ready: "true"
      tolerations: []
    windows:
      enabled: false
    syncSecret:
      enabled: false
    enableSecretRotation: true
    rotationPollInterval: 2m
    logVerbosity: 0
    tokenRequests:
      - audience: ${api_audience}
        expirationSeconds: 600
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: openbao-provider
  namespace: kube-system
  annotations:
    homelab.io/chart-source: https://github.com/openbao/openbao-helm/releases/download/openbao-0.30.7/openbao-0.30.7.tgz
    homelab.io/chart-sha256: fa4e6f3c1bbe936dc7ba079f1303ea56810af2f8600f046d8d5809860a4f980f
spec:
  chartContent: ${provider_chart}
  targetNamespace: secrets-system
  timeout: 10m0s
  failurePolicy: abort
  backOffLimit: 0
  valuesContent: |
    global:
      enabled: false
      tlsDisable: false
      externalBaoAddr: ${bao_address}
    server:
      enabled: false
    injector:
      enabled: false
    ui:
      enabled: false
    csi:
      enabled: true
      debug: false
      image:
        registry: quay.io
        repository: openbao/openbao-csi-provider
        tag: 2.0.3@sha256:ad30d5f6223f30f62e8df6e444b84af5b05402a70c09712415dd1d7f139c027e
      agent:
        enabled: false
      pod:
        nodeSelector:
          homelab.io/role: worker
          homelab.node-restriction.kubernetes.io/secrets-ready: "true"
        tolerations: []
      daemonSet:
        kubeletRootDir: /var/lib/kubelet
        providersDir: /etc/kubernetes/secrets-store-csi-providers
        securityContext:
          pod:
            seccompProfile:
              type: RuntimeDefault
          container:
            runAsUser: 0
            runAsGroup: 1000
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
            capabilities:
              drop: [ALL]
      extraArgs:
        - -cache-size=0
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 250m
          memory: 256Mi
