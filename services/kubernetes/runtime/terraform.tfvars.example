# Copy to terraform.tfvars, fill runtime configuration, and never commit it.
# Runtime-only definitions. Keep populated metadata private and actual values out.
# -----------------------------------------------------------------------------
# Provider
# -----------------------------------------------------------------------------
# Inject TF_VAR_openbao_admin_token ephemerally; never put the token in tfvars.
# Load the approved guest SSH identity into the operator's agent.
# API/SSH-user/worker-cohort metadata comes from the infrastructure state.
# OpenBao publishes its api_endpoint JSON output; never read the hosting state.
# Required when secrets_platform is enabled:
# openbao_endpoint_file =

# -----------------------------------------------------------------------------
# Core (optional until the cluster is enrolled)
# -----------------------------------------------------------------------------
# secrets_platform = null
# secrets_platform = {
#   kubeconfig_path =
#   auth_mount      =
#   api_audience    =
#   workers = {
#     # Both actual worker names: { node_uid = <verified>, host_key = <pinned public key> }
#   }
# }
# -----------------------------------------------------------------------------
# Private DNS (optional; requires enabled API runtime inputs)
# -----------------------------------------------------------------------------
# private_dns_forwarding = null
# private_dns_forwarding = {
#   zone     =
#   resolver =
# }
# -----------------------------------------------------------------------------
# Qualification (optional; enable only after the platform CRDs are installed)
# -----------------------------------------------------------------------------
# secrets_qualification = null
# secrets_qualification = {
#   secret_path =
#   replicas    = 0
# }

# -----------------------------------------------------------------------------
# Recovery custody (optional administrative definitions, never populated values)
# -----------------------------------------------------------------------------
# recovery_custody = null
# recovery_custody = {
#   kv_v2_mount              =
#   cluster_uid              =
#   server_token_hash        =
#   backup_credential_sha256 =
# }
