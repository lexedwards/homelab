# Copy to terraform.tfvars, fill enabled feature inputs, and never commit it.
# -----------------------------------------------------------------------------
# Provider — Optional until a feature is enabled
# -----------------------------------------------------------------------------
# Inject VAULT_TOKEN for secret-platform administration; never persist it here.
# cluster_api = null
# cluster_api = {
#   kubeconfig_path =
#   api_host        =
#   ssh_user        = null
#   workers         = []
# }
# API/SSH/cohort metadata comes from an inspected infrastructure output export,
# not a state read. SSH user/workers are required only for the secret platform.
# openbao_endpoint_file = null
# Supply the absolute published OpenBao api_endpoint JSON file when enabling CSI.
# -----------------------------------------------------------------------------
# Mounted workload secrets — Optional
# -----------------------------------------------------------------------------
# secrets_platform = null
# secrets_platform = {
#   auth_mount   =
#   api_audience =
#   workers = {
#     # Each reviewed worker name maps to { node_uid = ..., host_key = ... }.
#   }
# }
# -----------------------------------------------------------------------------
# Private DNS forwarding — Optional, independent of workload secrets
# -----------------------------------------------------------------------------
# private_dns_forwarding = null
# private_dns_forwarding = {
#   zone     =
#   resolver =
# }
# -----------------------------------------------------------------------------
# Observability — Optional, independent of workload secrets
# -----------------------------------------------------------------------------
# observability = null
# observability = {
#   cluster_name        =
#   warehouse_url       =
#   warehouse_ipv4      =
#   warehouse_port      =
#   dns_ipv4            =
#   node_ipv4_addresses = []
#   api_ipv4_addresses  = []
#   allow_plaintext     = false
# }
