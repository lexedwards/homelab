[Unit]
Description=Refresh warehouse credentials directly from OpenBao
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/observability-warehouse/approle.json

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/warehouse-credentials refresh
User=root
UMask=0077
TimeoutStartSec=15min
LimitCORE=0
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/etc/observability-warehouse /run/observability-credentials
