#cloud-config
hostname: grafana

packages:
  - ca-certificates
  - curl
  - openssl
  - qemu-guest-agent
  - [grafana, "${grafana_version}"]

write_files:
  - path: /etc/apt/preferences.d/grafana
    owner: root:root
    permissions: "0644"
    content: |
      Package: grafana
      Pin: version ${grafana_version}
      Pin-Priority: 1001
  - path: /etc/grafana/provisioning/datasources/observability-warehouse.yaml
    owner: root:grafana
    permissions: "0640"
    defer: true
    content: ${jsonencode(grafana_datasources)}
  - path: /etc/systemd/system/grafana-server.service.d/observability.conf
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      ConditionPathExists=/etc/grafana/grafana-admin.env

      [Service]
      EnvironmentFile=/etc/grafana/grafana-admin.env
      Environment=GF_AUTH_BASIC_PASSWORD_POLICY=true
      Environment=GF_ANALYTICS_REPORTING_ENABLED=false
      Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false

runcmd:
  - [bash, -ec, "umask 077; password=$(openssl rand -hex 32); test -n \"$password\"; temporary=$(mktemp /etc/grafana/.grafana-admin.env.XXXXXX); printf 'GF_SECURITY_ADMIN_PASSWORD=%s\\n' \"$password\" > \"$temporary\"; mv \"$temporary\" /etc/grafana/grafana-admin.env"]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, grafana-server]
  - [bash, -ec, "for attempt in $(seq 1 60); do if curl --fail --silent http://127.0.0.1:3000/api/health; then exit 0; fi; sleep 2; done; exit 1"]
