#cloud-config
hostname: telemetry-collector

packages:
  - ca-certificates
  - curl
  - qemu-guest-agent
  - [alloy, "${alloy_version}"]

write_files:
  - path: /etc/apt/preferences.d/alloy
    owner: root:root
    permissions: "0644"
    content: |
      Package: alloy
      Pin: version ${alloy_version}
      Pin-Priority: 1001
  - path: /etc/systemd/system/alloy.service.d/observability.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      ConditionPathExists=/etc/alloy/copilot.alloy

      [Service]
      ExecStartPre=/usr/bin/alloy validate --stability.level=experimental /etc/alloy
  - path: /etc/alloy/config.alloy
    owner: root:alloy
    permissions: "0640"
    defer: true
    content: ${jsonencode(alloy_config)}
  - path: /etc/alloy/copilot.alloy
    owner: root:alloy
    permissions: "0640"
    defer: true
    content: ${jsonencode(copilot_alloy_config)}
  - path: /etc/default/alloy
    owner: root:root
    permissions: "0644"
    defer: true
    content: ${jsonencode(alloy_environment)}

runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, alloy]
  - [bash, -ec, "for attempt in $(seq 1 30); do if curl --fail --silent http://127.0.0.1:12345/-/ready; then exit 0; fi; sleep 2; done; exit 1"]
