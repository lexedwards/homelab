# Assign required environment-specific values after copying this file to
# terraform.tfvars. Do not commit that file.
# For adoption, copy existing values from the reviewed inventory, not provider
# defaults. Empty lists clear server lists; use them only when actually empty.

# -----------------------------------------------------------------------------
# Providers
# -----------------------------------------------------------------------------

# Required
# incus_remote          =
# technitium_server_url =

# Supply the admin-level API token through TECHNITIUM_API_TOKEN outside this file.
# Verified HTTPS or a separately reviewed secure access path is required.

# -----------------------------------------------------------------------------
# Instance
# -----------------------------------------------------------------------------

# Required
# instance_vlan_id =

# Optional
# incus_image = "images:debian/13/cloud"

# -----------------------------------------------------------------------------
# Server settings (all required; preserve existing values)
# -----------------------------------------------------------------------------

