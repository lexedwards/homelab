#cloud-config
apt:
  preserve_sources_list: true
  sources:
    tailscale:
      source: deb [signed-by=$KEY_FILE] https://pkgs.tailscale.com/stable/debian trixie main
      key: ${jsonencode(signing_key)}

package_update: true
packages:
  - ca-certificates
  - tailscale
  - tailscale-archive-keyring

runcmd:
  - [systemctl, enable, --now, tailscaled]
