#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-cli
  - docker-compose

write_files:
  - path: /opt/uptime-kuma/compose.yaml
    permissions: "0644"
    owner: root:root
    content: ${jsonencode(compose_config)}
  - path: /etc/systemd/system/uptime-kuma.service
    permissions: "0644"
    owner: root:root
    content: ${jsonencode(service_unit)}

runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, docker]
  - [systemctl, enable, --now, uptime-kuma]
