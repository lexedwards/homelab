ui = true
api_addr = ${jsonencode(api_addr)}
cluster_addr = "https://127.0.0.1:8201"

storage "raft" {
  path = "/opt/openbao/data"
  node_id = "openbao"
}

listener "tcp" {
  address = "0.0.0.0:8200"
  cluster_address = "127.0.0.1:8201"
  tls_disable = false
  tls_cert_file = "/etc/openbao/tls/current/fullchain.pem"
  tls_key_file = "/etc/openbao/tls/current/privkey.pem"
  tls_min_version = "tls12"
}
