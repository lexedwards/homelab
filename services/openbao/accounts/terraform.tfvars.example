# Copy to ignored terraform.tfvars. Never commit the populated file.
# Supply the administrative token through protected VAULT_TOKEN injection.

# -----------------------------------------------------------------------------
# Provider
# -----------------------------------------------------------------------------
# Required
# openbao_address =

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Required: use hardening's published outputs, not its state.
# userpass_mount        =
# administrator_policy  =
# operator_username     =

# Optional: null leaves warehouse secret-value access disabled. When enabled,
# use the exact secret_path supplied to the warehouse access root, not its state.
# warehouse_secret_path = null
